PORT=8787
SEED=42
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
GD_CONTRACT=
ITEMS_CONTRACT=
MARKET_CONTRACT=
ROOT_ACCOUNT=
# Full ed25519 secret for ROOT_ACCOUNT (oracle/treasury signer), e.g. ed25519:...
# If empty/placeholder, falls back to ~/.near-credentials/<NEAR_NETWORK>/<ROOT_ACCOUNT>.json
TREASURY_KEY=
# 64-char hex (32 bytes) preferred; any passphrase also works via scrypt
KEY_ENCRYPTION_SECRET=
# NEAR transferred to each new player subaccount
PLAYER_FUND_NEAR=0.05
# Optional. If set, POST /auth/login must send the same inviteCode for new accounts.
# INVITE_CODE=
# New-account limits (returning names are not counted)
SIGNUP_IP_PER_HOUR=5
SIGNUP_HOURLY_CAP=30

# If empty, GET /admin/health returns 404. The /admin page sends this as x-admin-token.
# ADMIN_TOKEN=
# Optional. Defaults: CHAIN_ROOT = ROOT_ACCOUNT without the "players." prefix;
# treasury/chef/smith/dealer are subaccounts of CHAIN_ROOT; TOPUP_ACCOUNT = CHAIN_ROOT.
# Set TOPUP_ACCOUNT to the spare faucet (see docs/ACCOUNTS.md) if that account should send the NEAR.
# CHAIN_ROOT=
# TREASURY_ACCOUNT=
# MERCHANT_CHEF=
# MERCHANT_SMITH=
# MERCHANT_DEALER=
# TOPUP_ACCOUNT=

# Optional override (default: server/data/glitch.sqlite)
# DB_PATH=
