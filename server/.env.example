CHAIN_MODE=mock
PORT=8787
SEED=42
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

NEAR_NETWORK=testnet
# rpc.testnet.near.org is deprecated. test.rpc.fastnear.com rate-limits this app's /me poll.
# NEAR_RPC_URL=https://near-testnet.drpc.org
# Mock defaults (no secrets). For testnet set CHAIN_MODE=testnet and real values below.
GD_CONTRACT=gd.mock
ITEMS_CONTRACT=items.mock
MARKET_CONTRACT=market.mock
ROOT_ACCOUNT=players.mock
# Full ed25519 secret for ROOT_ACCOUNT (oracle/treasury signer), e.g. ed25519:...
# Required when CHAIN_MODE=testnet. Empty in mock.
TREASURY_KEY=
# 64-char hex (32 bytes) preferred; any passphrase also works via scrypt
# Required when CHAIN_MODE=testnet. Empty in mock.
KEY_ENCRYPTION_SECRET=
# NEAR transferred to each new player subaccount (testnet only)
PLAYER_FUND_NEAR=0.05
# Optional. If set, POST /auth/login must send the same inviteCode for new accounts.
# INVITE_CODE=
# New-account limits (returning names are not counted)
SIGNUP_IP_PER_HOUR=5
SIGNUP_HOURLY_CAP=30

# If empty, GET /admin/health returns 404. The /admin page sends this as x-admin-token.
# ADMIN_TOKEN=
# Google Identity Services OAuth client id (public). Empty disables Sign in with Google.
# GOOGLE_CLIENT_ID=
# Optional. Defaults: CHAIN_ROOT = ROOT_ACCOUNT without the "players." prefix;
# treasury is under CHAIN_ROOT; chef/smith/dealer are under ROOT_ACCOUNT (players.…);
# TOPUP_ACCOUNT = CHAIN_ROOT. Set TOPUP_ACCOUNT to a spare faucet (docs/ACCOUNTS.md) if needed.
# CHAIN_ROOT=
# TREASURY_ACCOUNT=
# MERCHANT_CHEF=
# MERCHANT_SMITH=
# MERCHANT_DEALER=
# TOPUP_ACCOUNT=

# Optional override (default: server/data/glitch.sqlite)
# DB_PATH=
